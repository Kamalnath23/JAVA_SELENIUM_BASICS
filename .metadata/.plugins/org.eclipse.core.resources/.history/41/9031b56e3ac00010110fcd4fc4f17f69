package Kamal.JavaSeleniumBasics.SeleniumWebDrivers;

import org.testng.annotations.Test;
import org.testng.asserts.SoftAssert;

public class Chapter5_Assertions {
  @Test
  public void softAssertion() {
	  System.out.println("This is a soft assertion test");
	  String expectedTitle = "Google";
	  String actualTitle = "Google";
	  String expectedTitle2 = "Bing";
	  String actualTitle2 = "Bing";
	  
	  SoftAssert softAssert = new SoftAssert();
	  softAssert.assertEquals(actualTitle, expectedTitle, "Title does not match for Google");
	  System.out.println("First assertion passed.");
	  softAssert.assertEquals(actualTitle2, expectedTitle2, "Title does not match for Bing");
	  System.out.println("Second assertion passed.");
	  softAssert.assertAll(); //Collate all assertions and report any failures
  }
}
