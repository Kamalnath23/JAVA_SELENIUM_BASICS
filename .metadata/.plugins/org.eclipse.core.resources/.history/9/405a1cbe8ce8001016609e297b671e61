package Kamal.JavaSeleniumBasics.SeleniumBasicConcepts;

import org.testng.annotations.Test;

import io.github.bonigarcia.wdm.WebDriverManager;

import java.time.Duration;

import org.openqa.selenium.Alert;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.edge.EdgeDriver;
import org.testng.annotations.BeforeTest;

public class Chapter11_Alert {
 WebDriver driver;
 Alert alert;
 String alertText;
  @BeforeTest
  public void beforeTest() {
	  WebDriverManager.edgedriver().setup();
		driver = new EdgeDriver();
		driver.manage().window().maximize(); // Maximize the browser window
		driver.get("https://www.letskodeit.com/practice"); // Open Bing website
		//Implicit wait
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
  }
  
  @Test(priority=0)
  public void handleAlert() {
	  driver.findElement(By.name("enter-name")).sendKeys("Kamal");
	  driver.findElement(By.xpath("//input[@value='Alert'")).click();
	  
	  //Switch to alert
	  alert = driver.switchTo().alert();
	  alertText = alert.getText();
	  System.out.println("Alert text: " + alertText);
	  alert.accept(); // Accept the alert
	  System.out.println("Alert accepted.");
	  
  }
  
  @Test(priority=1)
  public void handleConfirmAlert() {
	  driver.findElement(By.name("enter-name")).clear();
	  driver.findElement(By.name("enter-name")).sendKeys("Kamal");
	  driver.findElement(By.xpath("//input[@value='Alert'")).click();
  }

}
