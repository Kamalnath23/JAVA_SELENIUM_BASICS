public class Chapter12_SwitchToWindow {
	WebDriver driver;

	@BeforeTest
	public void beforeTest() {
		WebDriverManager.edgedriver().setup();
		driver = new EdgeDriver();
		driver.manage().window().maximize(); // Maximize the browser window
		driver.get("https://www.letskodeit.com/practice"); // Open Bing website
		// Implicit wait
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
	}

	@Test
	public void windowHandle() {
		//get the current window handle
		String mainWindowHandle = driver.getWindowHandle();
		System.out.println("Main Window Handle: " + mainWindowHandle);
		
		//click on the button which opens a new window
		driver.findElement(By.id("openwindow")).click();
		System.out.println("Clicked on 'Open Window' button.");
		
		//get all window handles
		Set<String> windowHandles = driver.getWindowHandles();
		System.out.println("All Window Handles: " + windowHandles);
